<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: a gold checkmark inside a ticket outline.

  A vector rather than PNG densities so the icon lives in version control as
  reviewable text. Drawn inside the central 72x72dp safe zone of the 108x108dp
  adaptive canvas, so the launcher's mask cannot clip it on any device.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ticket outline -->
    <path
        android:strokeColor="#B8944F"
        android:strokeWidth="3.5"
        android:fillColor="#00000000"
        android:pathData="M30,40 L78,40 A4,4 0 0 1 82,44 L82,52 A6,6 0 0 0 82,64 L82,72 A4,4 0 0 1 78,76 L30,76 A4,4 0 0 1 26,72 L26,64 A6,6 0 0 0 26,52 L26,44 A4,4 0 0 1 30,40 Z" />

    <!-- Checkmark -->
    <path
        android:strokeColor="#D7BE80"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M40,58 L49,67 L68,48" />
</vector>
