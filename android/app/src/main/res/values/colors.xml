<?xml version="1.0" encoding="utf-8"?>
<!--
  Only what the platform itself needs, outside Compose.

  The real palette lives in ui/theme/Palette.kt, where each colour carries its
  computed contrast ratio and the reasoning for it. Mirroring the full set here
  guarantees the two drift apart, and the XML copy is the one nobody remembers
  to update.

  Every entry below is referenced by a resource file — themes.xml or the
  adaptive icon. Nothing here is a general-purpose palette, and nothing should
  be added unless a framework XML file needs it by name.
-->
<resources>
    <!--
      The Activity window before the first composition. Parchment, matching the
      app: the framework draws this ahead of Compose, so a dark value here means
      every cold start flashes near-black, which at a door reads as a crash.
    -->
    <color name="parchment">#FFFAF7F2</color>

    <!--
      The adaptive icon's background tile. Deliberately DARK while the app
      itself is light — an icon is judged against a launcher wallpaper, not
      against the app, and a near-white tile disappears on a light home screen.
    -->
    <color name="ic_launcher_background">#FF1A1714</color>
</resources>
