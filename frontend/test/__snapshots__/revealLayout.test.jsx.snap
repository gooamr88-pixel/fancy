exports[`reveal artboard — coordinates > matches the open choreography exactly 1`] = `
"  opacity:0; visibility:hidden; transition:opacity .45s ease;
.ir3-fr{transition:transform 1350ms cubic-bezier(.4,0,1,1) 700ms,opacity 300ms cubic-bezier(.4,0,1,1) 1750ms}.ir3-root.is-open .ir3-fr{--mx:559px;opacity:0}
.ir3-fl{transition:transform 1350ms cubic-bezier(.4,0,1,1) 700ms,opacity 300ms cubic-bezier(.4,0,1,1) 1750ms}.ir3-root.is-open .ir3-fl{--mx:-559px;opacity:0}
.ir3-fb{transition:transform 1250ms cubic-bezier(.4,0,1,1) 820ms}.ir3-root.is-open .ir3-fb{--my:max(606px, calc(204px + 50vh))}
.ir3-ft{transition:transform 1250ms cubic-bezier(.4,0,1,1) 560ms}.ir3-root.is-open .ir3-ft{--my:calc(-1 * max(430px, 60px + 50vh))}
.ir3-fw{transition:opacity 360ms cubic-bezier(.4,0,1,1) 0ms}.ir3-root.is-open .ir3-fw{opacity:0}
.ir3-root.is-open .ir3-sl{animation:ir3-seal-break 1250ms linear 0ms both}
.ir3-tx{transition:opacity 360ms cubic-bezier(.4,0,1,1) 0ms}.ir3-root.is-open .ir3-tx{opacity:0}"
`;

