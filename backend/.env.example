# App Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Cache invalidation for public event pages.
#
# The event page caches this API's payload for 60s, including misses, so
# without these an event reads "not found" for a minute after it is created and
# keeps answering for a minute after it is deleted.
#
# REVALIDATE_SECRET must be the SAME value in the frontend's environment — the
# frontend handler compares them and refuses the purge on a mismatch. Generate
# with: openssl rand -hex 32
# Leave it unset and nothing breaks; pages simply age out on the 60s window and
# a warning is logged on every event change.
REVALIDATE_SECRET=
# Loopback address of the Next server. Never the public hostname: /api/* on the
# public host is routed to THIS backend by nginx, so a public URL here would
# make the backend call itself instead of the frontend.
INTERNAL_FRONTEND_URL=http://127.0.0.1:3000
JWT_SECRET=your-strong-jwt-secret-here
QR_JWT_SECRET=your-strong-qr-jwt-secret-here

# Supabase Configurations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-share

# Analytics
IP_HASH_SALT=your-random-32-byte-hex-string-for-ip-hashing

# ── Feature flags (paid integrations) ──────────────────────────────────────
# Both default to OFF. The platform runs fully on MANUAL payment with these off,
# and boots even with no Stripe/Twilio keys. Flip to true (with the keys below)
# to go live — no code changes needed.
#   PAYMENTS_STRIPE_ENABLED=true  → card checkout (event fee + SMS-credit top-ups)
#   SMS_ENABLED=true              → real Twilio SMS (otherwise logged in mock mode)
PAYMENTS_STRIPE_ENABLED=false
SMS_ENABLED=false

# Stripe Configurations (required only when PAYMENTS_STRIPE_ENABLED=true)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio Configurations.
# ALL THREE are required for SMS_ENABLED=true to take effect — smsEnabled() checks
# the credentials too, because a flag alone cannot dispatch a message. A partial
# configuration reports SMS as disabled (loudly, at boot) instead of degrading into
# a mock mode that looks like success.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Must be the toll-free number on the approved Toll-Free Verification. There is no
# default: an unset value disables SMS rather than falling back to a test number.
TWILIO_PHONE_NUMBER=+1234567890
# Optional. WhatsApp sender for the organizer's new-RSVP notification. Unset =
# the notification is skipped. Do NOT point this at Twilio's shared sandbox
# number (+14155238886): it only reaches handsets that manually joined it.
TWILIO_WHATSAPP_FROM=+1234567890
# Public webhook URLs (needed for Twilio signature verification behind a proxy):
# delivery receipts + inbound STOP/HELP opt-out recording.
SMS_STATUS_CALLBACK_URL=https://yourdomain.com/api/v1/public/sms/status
SMS_INBOUND_WEBHOOK_URL=https://yourdomain.com/api/v1/public/sms/inbound

# NEVER set this in production. It allows the SMS credit ledger to be debited when
# no Twilio transport exists — which is exactly the "charged for silence" failure
# the transport gate prevents. Set only by the offline unit suite.
# SMS_MOCK_BILLING=true

# ── SMS carrier ──────────────────────────────────────────────────────────────
# Which carrier actually sends. Default `twilio` = the behaviour that was here
# before Vonage existed. Everything above the transport (consent, STOP, billing,
# refunds) is identical either way, so this is a one-line switch and a restart.
#   twilio | vonage
SMS_PROVIDER=twilio

# ── Vonage (used only when SMS_PROVIDER=vonage) ──────────────────────────────
# Built on the SMS API, so these three are the whole credential set — no
# Application, no JWT, no private key on disk. See docs/SMS-Provider-Setup.md.
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Your Vonage number. Stored +E.164 here; the leading + is stripped on send.
VONAGE_FROM=+1XXXXXXXXXX
# REQUIRED in production. Delivery receipts trigger automatic refunds, so an
# UNSIGNED receipt endpoint would let anyone forge a failure and credit a wallet.
# Without this the status webhook refuses every request (fails closed). Inbound
# STOP is still accepted unsigned — dropping a real STOP is worse (fails safe).
VONAGE_SIGNATURE_SECRET=
# Must match the hash chosen in the Vonage dashboard.
#   md5hash | md5 | sha1 | sha256 | sha512
VONAGE_SIGNATURE_METHOD=sha256
# Does VONAGE answer the mandatory HELP keyword itself? Leave unset/false and we
# send the HELP reply. Vonage's keyword service (Opt-Out Assist) is documented for
# 10DLC and short codes, is opt-in, and does not list toll-free — so on toll-free
# we cannot assume it. Set true ONLY after confirming with Vonage, otherwise you
# get a duplicate reply. STOP is unaffected: it is network-level on toll-free and
# the carrier sends its own confirmation, so we never reply to that.
# VONAGE_CARRIER_HELP=false

# Brevo (Email) Configurations
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=info@yourdomain.com
BREVO_FROM_NAME=Fancy RSVP

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
